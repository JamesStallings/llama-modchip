+        }
+        {
+            const __m256i s256_1 = _mm256_add_epi32(_mm512_castsi512_si256(sumi1), _mm512_extracti64x4_epi64(sumi1, 1));
+            acc1 = _mm256_fmadd_ps(_mm256_set1_ps(y1[i].d * dx), _mm256_cvtepi32_ps(s256_1), acc1);
+        }
+        {
+            const __m256i s256_2 = _mm256_add_epi32(_mm512_castsi512_si256(sumi2), _mm512_extracti64x4_epi64(sumi2, 1));
+            acc2 = _mm256_fmadd_ps(_mm256_set1_ps(y2[i].d * dx), _mm256_cvtepi32_ps(s256_2), acc2);
+        }
+        {
+            const __m256i s256_3 = _mm256_add_epi32(_mm512_castsi512_si256(sumi3), _mm512_extracti64x4_epi64(sumi3, 1));
+            acc3 = _mm256_fmadd_ps(_mm256_set1_ps(y3[i].d * dx), _mm256_cvtepi32_ps(s256_3), acc3);
