+                const __m512i dot34  = _mm512_maddubs_epi16(ones512, _mm512_mask_sub_epi8(q8_all, delta_neg, zero512, q8_all));
+                sumi1_7 = _mm512_add_epi32(sumi1_7, _mm512_madd_epi16(dot12, scale_512));
