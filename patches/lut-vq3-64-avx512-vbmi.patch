+    s[0] = hsum_float_8(_mm256_fmadd_ps(acc2_0, v_delta, acc1_0));
+    s[1] = hsum_float_8(_mm256_fmadd_ps(acc2_1, v_delta, acc1_1));
+    s[2] = hsum_float_8(_mm256_fmadd_ps(acc2_2, v_delta, acc1_2));
+    s[3] = hsum_float_8(_mm256_fmadd_ps(acc2_3, v_delta, acc1_3));
+    s[4] = hsum_float_8(_mm256_fmadd_ps(acc2_4, v_delta, acc1_4));
+    s[5] = hsum_float_8(_mm256_fmadd_ps(acc2_5, v_delta, acc1_5));
+    s[6] = hsum_float_8(_mm256_fmadd_ps(acc2_6, v_delta, acc1_6));
+    s[7] = hsum_float_8(_mm256_fmadd_ps(acc2_7, v_delta, acc1_7));
+#else
+    for (int k = 0; k < 8; ++k) ggml_vec_dot_iq1_m_q8_K(n, &s[k], 0, vx, 0, vy[k], 0, 1);
+#endif
