+            const __m256i q1b_1 = _mm256_set_epi64x(iq1s_grid[(uint16_t)(packed_idx1 >> 48)], iq1s_grid[(uint16_t)(packed_idx1 >> 32)], iq1s_grid[(uint16_t)(packed_idx1 >> 16)], iq1s_grid[(uint16_t)packed_idx1]);
