+            acc5 = _mm256_fmadd_ps(_mm256_set1_ps(y5[i].d * dx), _mm256_cvtepi32_ps(s256_5), acc5);
+        }
+        {
+            const __m256i s256_6 = _mm256_add_epi32(_mm512_castsi512_si256(sumi6), _mm512_extracti64x4_epi64(sumi6, 1));
+            acc6 = _mm256_fmadd_ps(_mm256_set1_ps(y6[i].d * dx), _mm256_cvtepi32_ps(s256_6), acc6);
+        }
