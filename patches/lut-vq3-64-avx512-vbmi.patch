+            const __m512i sc_01 = _mm512_inserti64x4(_mm512_castsi256_si512(scale_0), scale_1, 1);
+            {
+                const __m512i q8_01 = _mm512_loadu_si512((const __m512i *)(y0[i].qs + 64*j));
