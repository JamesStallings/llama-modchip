+                sumi7 = _mm512_add_epi32(sumi7, _mm512_madd_epi16(_mm512_maddubs_epi16(q2_512, q8_s), v_ls));
+            }
+        }
+        {
+            const __m256i s256_0 = _mm256_add_epi32(_mm512_castsi512_si256(sumi0), _mm512_extracti64x4_epi64(sumi0, 1));
+            acc0 = _mm256_fmadd_ps(_mm256_set1_ps(dx * y0[i].d), _mm256_cvtepi32_ps(s256_0), acc0);
+        }
+        {
+            const __m256i s256_1 = _mm256_add_epi32(_mm512_castsi512_si256(sumi1), _mm512_extracti64x4_epi64(sumi1, 1));
+            acc1 = _mm256_fmadd_ps(_mm256_set1_ps(dx * y1[i].d), _mm256_cvtepi32_ps(s256_1), acc1);
+        }
+        {
+            const __m256i s256_2 = _mm256_add_epi32(_mm512_castsi512_si256(sumi2), _mm512_extracti64x4_epi64(sumi2, 1));
+            acc2 = _mm256_fmadd_ps(_mm256_set1_ps(dx * y2[i].d), _mm256_cvtepi32_ps(s256_2), acc2);
+        }
+        {
+            const __m256i s256_3 = _mm256_add_epi32(_mm512_castsi512_si256(sumi3), _mm512_extracti64x4_epi64(sumi3, 1));
+            acc3 = _mm256_fmadd_ps(_mm256_set1_ps(dx * y3[i].d), _mm256_cvtepi32_ps(s256_3), acc3);
+        }
+        {
+            const __m256i s256_4 = _mm256_add_epi32(_mm512_castsi512_si256(sumi4), _mm512_extracti64x4_epi64(sumi4, 1));
+            acc4 = _mm256_fmadd_ps(_mm256_set1_ps(dx * y4[i].d), _mm256_cvtepi32_ps(s256_4), acc4);
+        }
+        {
+            const __m256i s256_5 = _mm256_add_epi32(_mm512_castsi512_si256(sumi5), _mm512_extracti64x4_epi64(sumi5, 1));
+            acc5 = _mm256_fmadd_ps(_mm256_set1_ps(dx * y5[i].d), _mm256_cvtepi32_ps(s256_5), acc5);
+        }
+        {
+            const __m256i s256_6 = _mm256_add_epi32(_mm512_castsi512_si256(sumi6), _mm512_extracti64x4_epi64(sumi6, 1));
