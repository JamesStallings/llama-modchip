+        utmp[3] = ((utmp[2] >> 4) & kmask2) | (((utmp[1] >> 6) & kmask3) << 4);
+        const uint32_t uaux = utmp[1] & kmask1;
+        utmp[1] = (utmp[2] & kmask2) | (((utmp[0] >> 6) & kmask3) << 4);
+        utmp[2] = uaux;
+        utmp[0] &= kmask1;
+
+        const __m256i mins_and_scales = _mm256_cvtepu8_epi16(_mm_set_epi32(utmp[3], utmp[2], utmp[1], utmp[0]));
+        const __m128i mins128 = _mm256_extracti128_si256(mins_and_scales, 1);
+        {
+            const __m256i q8sums = _mm256_loadu_si256((const __m256i*)y0[i].bsums);
+            const __m128i q8s = _mm_hadd_epi16(_mm256_extracti128_si256(q8sums, 0), _mm256_extracti128_si256(q8sums, 1));
+            const __m128i prod = _mm_madd_epi16(mins128, q8s);
+            const __m128i hsum = _mm_hadd_epi32(_mm_hadd_epi32(prod, mzero), mzero);
+            summs0 += y0[i].d * dmin * _mm_extract_epi32(hsum, 0);
+        }
+        {
+            const __m256i q8sums = _mm256_loadu_si256((const __m256i*)y1[i].bsums);
+            const __m128i q8s = _mm_hadd_epi16(_mm256_extracti128_si256(q8sums, 0), _mm256_extracti128_si256(q8sums, 1));
+            const __m128i prod = _mm_madd_epi16(mins128, q8s);
+            const __m128i hsum = _mm_hadd_epi32(_mm_hadd_epi32(prod, mzero), mzero);
+            summs1 += y1[i].d * dmin * _mm_extract_epi32(hsum, 0);
+        }
+        const __m128i sc128  = _mm256_extracti128_si256(mins_and_scales, 0);
+        const __m256i scales = MM256_SET_M128I(sc128, sc128);
+        const __m256i hbits  = _mm256_loadu_si256((const __m256i*)x[i].qh);
+        __m256i hmask = mone;
+        __m512i sumi0 = _mm512_setzero_si512();
+        __m512i sumi1 = _mm512_setzero_si512();
+        int bit = 0;
+
+        for (int j = 0; j < QK_K/64; ++j) {
+            const __m256i scale_0 = _mm256_shuffle_epi8(scales, get_scale_shuffle_k4(2*j+0));
+            const __m256i scale_1 = _mm256_shuffle_epi8(scales, get_scale_shuffle_k4(2*j+1));
+            const __m256i q5bits  = _mm256_loadu_si256((const __m256i*)q5); q5 += 32;
+
+            const __m256i q5l_0 = _mm256_and_si256(q5bits, m4);
+            const __m256i q5h_0 = _mm256_slli_epi16(_mm256_srli_epi16(_mm256_and_si256(hbits, hmask), bit++), 4);
+            const __m256i q5_0  = _mm256_add_epi8(q5l_0, q5h_0);
+            hmask = _mm256_slli_epi16(hmask, 1);
+
+            const __m256i q5l_1 = _mm256_and_si256(_mm256_srli_epi16(q5bits, 4), m4);
+            const __m256i q5h_1 = _mm256_slli_epi16(_mm256_srli_epi16(_mm256_and_si256(hbits, hmask), bit++), 4);
+            const __m256i q5_1  = _mm256_add_epi8(q5l_1, q5h_1);
+            hmask = _mm256_slli_epi16(hmask, 1);
+
+            const __m512i q5_01 = _mm512_inserti64x4(_mm512_castsi256_si512(q5_0), q5_1, 1);
+            const __m512i sc_01 = _mm512_inserti64x4(_mm512_castsi256_si512(scale_0), scale_1, 1);
+            {
+                const __m512i q8_01 = _mm512_loadu_si512((const __m512i *)(y0[i].qs + 64*j));
+                sumi0 = _mm512_add_epi32(sumi0, _mm512_madd_epi16(sc_01, _mm512_maddubs_epi16(q5_01, q8_01)));
+            }
+            {
+                const __m512i q8_01 = _mm512_loadu_si512((const __m512i *)(y1[i].qs + 64*j));
+                sumi1 = _mm512_add_epi32(sumi1, _mm512_madd_epi16(sc_01, _mm512_maddubs_epi16(q5_01, q8_01)));
+            }
+        }
+        {
+            const __m256i s256_0 = _mm256_add_epi32(_mm512_castsi512_si256(sumi0), _mm512_extracti64x4_epi64(sumi0, 1));
+            acc0 = _mm256_fmadd_ps(_mm256_set1_ps(y0[i].d * dx), _mm256_cvtepi32_ps(s256_0), acc0);
+        }
+        {
+            const __m256i s256_1 = _mm256_add_epi32(_mm512_castsi512_si256(sumi1), _mm512_extracti64x4_epi64(sumi1, 1));
+            acc1 = _mm256_fmadd_ps(_mm256_set1_ps(y1[i].d * dx), _mm256_cvtepi32_ps(s256_1), acc1);
+        }
+    }
+    s[0] = hsum_float_8(acc0) + summs0;
+    s[1] = hsum_float_8(acc1) + summs1;
+#else
+    for (int k = 0; k < 2; ++k) ggml_vec_dot_q5_K_q8_K(n, &s[k], 0, vx, 0, vy[k], 0, 1);
+#endif
+}
+
+void ggml_vec_dot_q6_K_q8_K_1x2(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * const * GGML_RESTRICT vy) {
+#if defined(__AVX512F__) && defined(__AVX512BW__) && defined(__AVX512VL__)
+    const int nb = n / QK_K;
+    const block_q6_K * GGML_RESTRICT x = (const block_q6_K *)vx;
+    const block_q8_K * GGML_RESTRICT y0 = (const block_q8_K *)vy[0];
+    const block_q8_K * GGML_RESTRICT y1 = (const block_q8_K *)vy[1];
+    const __m256i m3  = _mm256_set1_epi8(3);
+    const __m256i m15 = _mm256_set1_epi8(15);
+    __m256 acc0 = _mm256_setzero_ps();
+    __m256 acc1 = _mm256_setzero_ps();
+
+    for (int i = 0; i < nb; ++i) {
+        const float dx = GGML_CPU_FP16_TO_FP32(x[i].d);
+        const uint8_t * GGML_RESTRICT q4 = x[i].ql;
+        const uint8_t * GGML_RESTRICT qh = x[i].qh;
+        const __m128i scales    = _mm_loadu_si128((const __m128i*)x[i].scales);
+        const __m256i scales_16 = _mm256_cvtepi8_epi16(scales);
+        const __m256i q8sclsub0 = _mm256_slli_epi32(_mm256_madd_epi16(_mm256_loadu_si256((const __m256i*)y0[i].bsums), scales_16), 5);
+        const __m256i q8sclsub1 = _mm256_slli_epi32(_mm256_madd_epi16(_mm256_loadu_si256((const __m256i*)y1[i].bsums), scales_16), 5);
+        __m512i sumi0 = _mm512_setzero_si512();
+        __m512i sumi1 = _mm512_setzero_si512();
+        int is = 0;
+        for (int j = 0; j < QK_K/128; ++j) {
+            const __m256i q4bits1 = _mm256_loadu_si256((const __m256i*)q4); q4 += 32;
+            const __m256i q4bits2 = _mm256_loadu_si256((const __m256i*)q4); q4 += 32;
+            const __m256i q4bitsH = _mm256_loadu_si256((const __m256i*)qh); qh += 32;
+
+            const __m256i q4h_0 = _mm256_slli_epi16(_mm256_and_si256(q4bitsH, m3), 4);
+            const __m256i q4h_1 = _mm256_slli_epi16(_mm256_and_si256(q4bitsH, _mm256_set1_epi8(12)), 2);
+            const __m256i q4h_2 = _mm256_and_si256(q4bitsH, _mm256_set1_epi8(48));
+            const __m256i q4h_3 = _mm256_srli_epi16(_mm256_and_si256(q4bitsH, _mm256_set1_epi8(-64)), 2);
+
+            const __m256i q4_0 = _mm256_or_si256(_mm256_and_si256(q4bits1, m15), q4h_0);
+            const __m256i q4_1 = _mm256_or_si256(_mm256_and_si256(q4bits2, m15), q4h_1);
+            const __m256i q4_2 = _mm256_or_si256(_mm256_and_si256(_mm256_srli_epi16(q4bits1, 4), m15), q4h_2);
+            const __m256i q4_3 = _mm256_or_si256(_mm256_and_si256(_mm256_srli_epi16(q4bits2, 4), m15), q4h_3);
+
+            const __m256i sc16_0 = _mm256_cvtepi8_epi16(_mm_shuffle_epi8(scales, get_scale_shuffle(is + 0)));
+            const __m256i sc16_1 = _mm256_cvtepi8_epi16(_mm_shuffle_epi8(scales, get_scale_shuffle(is + 1)));
+            const __m256i sc16_2 = _mm256_cvtepi8_epi16(_mm_shuffle_epi8(scales, get_scale_shuffle(is + 2)));
+            const __m256i sc16_3 = _mm256_cvtepi8_epi16(_mm_shuffle_epi8(scales, get_scale_shuffle(is + 3)));
+            is += 4;
+
+            const __m512i q6_01 = _mm512_inserti64x4(_mm512_castsi256_si512(q4_0), q4_1, 1);
+            const __m512i q6_23 = _mm512_inserti64x4(_mm512_castsi256_si512(q4_2), q4_3, 1);
+            const __m512i sc_01 = _mm512_inserti64x4(_mm512_castsi256_si512(sc16_0), sc16_1, 1);
+            const __m512i sc_23 = _mm512_inserti64x4(_mm512_castsi256_si512(sc16_2), sc16_3, 1);
+            {
+                const __m512i q8_01 = _mm512_loadu_si512((const __m512i *)(y0[i].qs + 128*j +  0));
+                const __m512i q8_23 = _mm512_loadu_si512((const __m512i *)(y0[i].qs + 128*j + 64));
+                sumi0 = _mm512_add_epi32(sumi0, _mm512_madd_epi16(sc_01, _mm512_maddubs_epi16(q6_01, q8_01)));
+                sumi0 = _mm512_add_epi32(sumi0, _mm512_madd_epi16(sc_23, _mm512_maddubs_epi16(q6_23, q8_23)));
+            }
+            {
+                const __m512i q8_01 = _mm512_loadu_si512((const __m512i *)(y1[i].qs + 128*j +  0));
+                const __m512i q8_23 = _mm512_loadu_si512((const __m512i *)(y1[i].qs + 128*j + 64));
+                sumi1 = _mm512_add_epi32(sumi1, _mm512_madd_epi16(sc_01, _mm512_maddubs_epi16(q6_01, q8_01)));
+                sumi1 = _mm512_add_epi32(sumi1, _mm512_madd_epi16(sc_23, _mm512_maddubs_epi16(q6_23, q8_23)));
+            }
+        }
+        {
+            const __m256i s256_0 = _mm256_sub_epi32(_mm256_add_epi32(_mm512_castsi512_si256(sumi0), _mm512_extracti64x4_epi64(sumi0, 1)), q8sclsub0);
+            acc0 = _mm256_fmadd_ps(_mm256_set1_ps(y0[i].d * dx), _mm256_cvtepi32_ps(s256_0), acc0);
+        }
+        {
+            const __m256i s256_1 = _mm256_sub_epi32(_mm256_add_epi32(_mm512_castsi512_si256(sumi1), _mm512_extracti64x4_epi64(sumi1, 1)), q8sclsub1);
+            acc1 = _mm256_fmadd_ps(_mm256_set1_ps(y1[i].d * dx), _mm256_cvtepi32_ps(s256_1), acc1);
+        }
+    }
+    s[0] = hsum_float_8(acc0);
+    s[1] = hsum_float_8(acc1);
+#else
+    for (int k = 0; k < 2; ++k) ggml_vec_dot_q6_K_q8_K(n, &s[k], 0, vx, 0, vy[k], 0, 1);
+#endif
+}
