+void ggml_vec_dot_iq1_m_q8_K_1x4(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * const * GGML_RESTRICT vy) {
+#if defined(__AVX512F__) && defined(__AVX512BW__) && defined(__AVX512VL__) && defined(__BMI2__)
+    const int nb = n / QK_K;
+    const block_iq1_m * GGML_RESTRICT x = (const block_iq1_m *)vx;
+    const block_q8_K * GGML_RESTRICT y0 = (const block_q8_K *)vy[0];
+    const block_q8_K * GGML_RESTRICT y1 = (const block_q8_K *)vy[1];
+    const block_q8_K * GGML_RESTRICT y2 = (const block_q8_K *)vy[2];
+    const block_q8_K * GGML_RESTRICT y3 = (const block_q8_K *)vy[3];
+    __m256 acc1_0 = _mm256_setzero_ps(), acc2_0 = _mm256_setzero_ps();
+    __m256 acc1_1 = _mm256_setzero_ps(), acc2_1 = _mm256_setzero_ps();
+    __m256 acc1_2 = _mm256_setzero_ps(), acc2_2 = _mm256_setzero_ps();
+    __m256 acc1_3 = _mm256_setzero_ps(), acc2_3 = _mm256_setzero_ps();
+    iq1m_scale_t scale;
+    const __m256i mask = _mm256_set1_epi16(0x7);
+    const __m256i mone = _mm256_set1_epi16(1);
+    const __m256i mone8 = _mm256_set1_epi8(1);
+    const __m256i mtwo8 = _mm256_set1_epi8(2);
+    const __m256i scales_shift = _mm256_set_epi64x(9, 3, 6, 0);
+    const __m512i zero512 = _mm512_setzero_si512();
+    const __m512i ones512 = _mm512_set1_epi8(1);
+
+    for (int i = 0; i < nb; ++i) {
+        const uint8_t  * qs = x[i].qs;
+        const uint8_t  * qh = x[i].qh;
+        const uint16_t * sc = (const uint16_t *)x[i].scales;
+        scale.u16 = (sc[0] >> 12) | ((sc[1] >> 8) & 0x00f0) | ((sc[2] >> 4) & 0x0f00) | (sc[3] & 0xf000);
+        const float dx = GGML_CPU_FP16_TO_FP32(scale.f16);
+
+        __m256i scales = _mm256_set1_epi64x(*(const uint64_t*)sc);
+        scales = _mm256_srlv_epi64(scales, scales_shift);
+        scales = _mm256_add_epi16(_mm256_slli_epi16(_mm256_and_si256(scales, mask), 1), mone);
+
+        __m256i scales_idx1 = _mm256_set1_epi16(0x0100);
+        __m256i scales_idx2 = _mm256_add_epi8(scales_idx1, _mm256_set1_epi8(8));
+        __m512i sumi1_0 = _mm512_setzero_si512(), sumi2_0 = _mm512_setzero_si512();
+        __m512i sumi1_1 = _mm512_setzero_si512(), sumi2_1 = _mm512_setzero_si512();
+        __m512i sumi1_2 = _mm512_setzero_si512(), sumi2_2 = _mm512_setzero_si512();
+        __m512i sumi1_3 = _mm512_setzero_si512(), sumi2_3 = _mm512_setzero_si512();
+        for (int ib = 0; ib < QK_K/32; ib += 2) {
+            const uint64_t packed_idx1 = _pdep_u64(*(const uint32_t *)qs, 0x00ff00ff00ff00ffULL)
+                                       | _pdep_u64(*(const uint16_t*)(qh) & 0x7777, 0xf000f000f000f00ULL);
+            const uint64_t packed_idx2 = _pdep_u64(*(const uint32_t *)(qs + 4), 0x00ff00ff00ff00ffULL)
+                                       | _pdep_u64(*(const uint16_t*)(qh + 2) & 0x7777, 0xf000f000f000f00ULL);
+            const __m256i q1b_1 = _mm256_set_epi64x(iq1s_grid[(uint16_t)(packed_idx1 >> 48)], iq1s_grid[(uint16_t)(packed_idx1 >> 32)], iq1s_grid[(uint16_t)(packed_idx1 >> 16)], iq1s_grid[(uint16_t)packed_idx1]);
+            const __m256i q1b_2 = _mm256_set_epi64x(iq1s_grid[(uint16_t)(packed_idx2 >> 48)], iq1s_grid[(uint16_t)(packed_idx2 >> 32)], iq1s_grid[(uint16_t)(packed_idx2 >> 16)], iq1s_grid[(uint16_t)packed_idx2]);
+            const __m512i q1b_512 = _mm512_inserti64x4(_mm512_castsi256_si512(q1b_1), q1b_2, 1);
+            const __m512i q1_abs  = _mm512_abs_epi8(q1b_512);
+            const __mmask64 q1_neg = _mm512_movepi8_mask(q1b_512);
+
+            const uint64_t delta_sign = _pdep_u64(*(const uint32_t*)(qh) & 0x88888888, 0xf0f0f0f0f0f0f0f0ULL);
+            const __m256i delta1 = _mm256_or_si256(mone8, _mm256_cvtepi8_epi64(_mm_set1_epi32(delta_sign)));
+            const __m256i delta2 = _mm256_or_si256(mone8, _mm256_cvtepi8_epi64(_mm_set1_epi32(delta_sign >> 32)));
+            const __m512i delta_512 = _mm512_inserti64x4(_mm512_castsi256_si512(delta1), delta2, 1);
+            const __mmask64 delta_neg = _mm512_movepi8_mask(delta_512);
+
+            const __m256i scale1 = _mm256_shuffle_epi8(scales, scales_idx1);
+            const __m256i scale2 = _mm256_shuffle_epi8(scales, scales_idx2);
+            scales_idx1 = _mm256_add_epi8(scales_idx1, mtwo8);
+            scales_idx2 = _mm256_add_epi8(scales_idx2, mtwo8);
+            const __m512i scale_512 = _mm512_inserti64x4(_mm512_castsi256_si512(scale1), scale2, 1);
+            {
+                const __m512i q8_all = _mm512_loadu_si512((const __m512i *)(y0[i].qs + 32*ib));
+                const __m512i dot12  = _mm512_maddubs_epi16(q1_abs, _mm512_mask_sub_epi8(q8_all, q1_neg, zero512, q8_all));
+                const __m512i dot34  = _mm512_maddubs_epi16(ones512, _mm512_mask_sub_epi8(q8_all, delta_neg, zero512, q8_all));
+                sumi1_0 = _mm512_add_epi32(sumi1_0, _mm512_madd_epi16(dot12, scale_512));
+                sumi2_0 = _mm512_add_epi32(sumi2_0, _mm512_madd_epi16(dot34, scale_512));
+            }
+            {
+                const __m512i q8_all = _mm512_loadu_si512((const __m512i *)(y1[i].qs + 32*ib));
+                const __m512i dot12  = _mm512_maddubs_epi16(q1_abs, _mm512_mask_sub_epi8(q8_all, q1_neg, zero512, q8_all));
+                const __m512i dot34  = _mm512_maddubs_epi16(ones512, _mm512_mask_sub_epi8(q8_all, delta_neg, zero512, q8_all));
+                sumi1_1 = _mm512_add_epi32(sumi1_1, _mm512_madd_epi16(dot12, scale_512));
+                sumi2_1 = _mm512_add_epi32(sumi2_1, _mm512_madd_epi16(dot34, scale_512));
+            }
+            {
+                const __m512i q8_all = _mm512_loadu_si512((const __m512i *)(y2[i].qs + 32*ib));
+                const __m512i dot12  = _mm512_maddubs_epi16(q1_abs, _mm512_mask_sub_epi8(q8_all, q1_neg, zero512, q8_all));
+                const __m512i dot34  = _mm512_maddubs_epi16(ones512, _mm512_mask_sub_epi8(q8_all, delta_neg, zero512, q8_all));
+                sumi1_2 = _mm512_add_epi32(sumi1_2, _mm512_madd_epi16(dot12, scale_512));
+                sumi2_2 = _mm512_add_epi32(sumi2_2, _mm512_madd_epi16(dot34, scale_512));
+            }
+            {
+                const __m512i q8_all = _mm512_loadu_si512((const __m512i *)(y3[i].qs + 32*ib));
+                const __m512i dot12  = _mm512_maddubs_epi16(q1_abs, _mm512_mask_sub_epi8(q8_all, q1_neg, zero512, q8_all));
+                const __m512i dot34  = _mm512_maddubs_epi16(ones512, _mm512_mask_sub_epi8(q8_all, delta_neg, zero512, q8_all));
+                sumi1_3 = _mm512_add_epi32(sumi1_3, _mm512_madd_epi16(dot12, scale_512));
+                sumi2_3 = _mm512_add_epi32(sumi2_3, _mm512_madd_epi16(dot34, scale_512));
+            }
+            qs += 8; qh += 4;
+        }
+        {
+            const __m256 d0 = _mm256_set1_ps(y0[i].d * dx);
+            const __m256i s1_256 = _mm256_add_epi32(_mm512_castsi512_si256(sumi1_0), _mm512_extracti64x4_epi64(sumi1_0, 1));
+            const __m256i s2_256 = _mm256_add_epi32(_mm512_castsi512_si256(sumi2_0), _mm512_extracti64x4_epi64(sumi2_0, 1));
+            acc1_0 = _mm256_fmadd_ps(d0, _mm256_cvtepi32_ps(s1_256), acc1_0);
+            acc2_0 = _mm256_fmadd_ps(d0, _mm256_cvtepi32_ps(s2_256), acc2_0);
+        }
+        {
+            const __m256 d1 = _mm256_set1_ps(y1[i].d * dx);
+            const __m256i s1_256 = _mm256_add_epi32(_mm512_castsi512_si256(sumi1_1), _mm512_extracti64x4_epi64(sumi1_1, 1));
+            const __m256i s2_256 = _mm256_add_epi32(_mm512_castsi512_si256(sumi2_1), _mm512_extracti64x4_epi64(sumi2_1, 1));
+            acc1_1 = _mm256_fmadd_ps(d1, _mm256_cvtepi32_ps(s1_256), acc1_1);
+            acc2_1 = _mm256_fmadd_ps(d1, _mm256_cvtepi32_ps(s2_256), acc2_1);
+        }
+        {
+            const __m256 d2 = _mm256_set1_ps(y2[i].d * dx);
+            const __m256i s1_256 = _mm256_add_epi32(_mm512_castsi512_si256(sumi1_2), _mm512_extracti64x4_epi64(sumi1_2, 1));
+            const __m256i s2_256 = _mm256_add_epi32(_mm512_castsi512_si256(sumi2_2), _mm512_extracti64x4_epi64(sumi2_2, 1));
+            acc1_2 = _mm256_fmadd_ps(d2, _mm256_cvtepi32_ps(s1_256), acc1_2);
+            acc2_2 = _mm256_fmadd_ps(d2, _mm256_cvtepi32_ps(s2_256), acc2_2);
+        }
+        {
+            const __m256 d3 = _mm256_set1_ps(y3[i].d * dx);
+            const __m256i s1_256 = _mm256_add_epi32(_mm512_castsi512_si256(sumi1_3), _mm512_extracti64x4_epi64(sumi1_3, 1));
+            const __m256i s2_256 = _mm256_add_epi32(_mm512_castsi512_si256(sumi2_3), _mm512_extracti64x4_epi64(sumi2_3, 1));
+            acc1_3 = _mm256_fmadd_ps(d3, _mm256_cvtepi32_ps(s1_256), acc1_3);
+            acc2_3 = _mm256_fmadd_ps(d3, _mm256_cvtepi32_ps(s2_256), acc2_3);
+        }
+    }
+    const __m256 v_delta = _mm256_set1_ps(IQ1M_DELTA);
+    s[0] = hsum_float_8(_mm256_fmadd_ps(acc2_0, v_delta, acc1_0));
+    s[1] = hsum_float_8(_mm256_fmadd_ps(acc2_1, v_delta, acc1_1));
+    s[2] = hsum_float_8(_mm256_fmadd_ps(acc2_2, v_delta, acc1_2));
+    s[3] = hsum_float_8(_mm256_fmadd_ps(acc2_3, v_delta, acc1_3));
+#else
+    for (int k = 0; k < 4; ++k) ggml_vec_dot_iq1_m_q8_K(n, &s[k], 0, vx, 0, vy[k], 0, 1);
+#endif
+}
