+            const __m256i s1_256 = _mm256_add_epi32(_mm512_castsi512_si256(sumi1_6), _mm512_extracti64x4_epi64(sumi1_6, 1));
+            const __m256i s2_256 = _mm256_add_epi32(_mm512_castsi512_si256(sumi2_6), _mm512_extracti64x4_epi64(sumi2_6, 1));
+            acc1_6 = _mm256_fmadd_ps(d6, _mm256_cvtepi32_ps(s1_256), acc1_6);
+            acc2_6 = _mm256_fmadd_ps(d6, _mm256_cvtepi32_ps(s2_256), acc2_6);
+        }
+        {
+            const __m256 d7 = _mm256_set1_ps(y7[i].d * dx);
+            const __m256i s1_256 = _mm256_add_epi32(_mm512_castsi512_si256(sumi1_7), _mm512_extracti64x4_epi64(sumi1_7, 1));
+            const __m256i s2_256 = _mm256_add_epi32(_mm512_castsi512_si256(sumi2_7), _mm512_extracti64x4_epi64(sumi2_7, 1));
