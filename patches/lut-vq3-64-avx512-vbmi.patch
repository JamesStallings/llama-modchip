+            const int16_t ls2 = 2*((qh[ib+1] >> 12) & 7) + 1;
+            const __m512i v_ls = _mm512_inserti64x4(_mm512_castsi256_si512(_mm256_set1_epi16(ls1)), _mm256_set1_epi16(ls2), 1);
