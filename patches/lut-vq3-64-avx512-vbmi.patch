+            acc7 = _mm256_fmadd_ps(_mm256_set1_ps(dx * y7[i].d), _mm256_cvtepi32_ps(s256_7), acc7);
+        }
+    }
+    s[0] = 0.125f * hsum_float_8(acc0);
+    s[1] = 0.125f * hsum_float_8(acc1);
+    s[2] = 0.125f * hsum_float_8(acc2);
+    s[3] = 0.125f * hsum_float_8(acc3);
