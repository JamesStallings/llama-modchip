+            }
+            {
+                const __m512i q8_all = _mm512_loadu_si512((const __m512i *)(y1[i].qs + 32*ib));
+                const __m512i q8_s   = _mm512_mask_sub_epi8(q8_all, neg_m, zero512, q8_all);
+                sumi1 = _mm512_add_epi32(sumi1, _mm512_madd_epi16(_mm512_maddubs_epi16(q1_abs, q8_s), v_ls));
+                sumi1_1 += (y1[i].bsums[2*ib+0] + y1[i].bsums[2*ib+1]) * dsign1 + (y1[i].bsums[2*ib+2] + y1[i].bsums[2*ib+3]) * dsign2;
