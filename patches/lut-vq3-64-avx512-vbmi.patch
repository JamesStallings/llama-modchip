+    s[1] = hsum_float_8(acc1) + summs1;
+    s[2] = hsum_float_8(acc2) + summs2;
+    s[3] = hsum_float_8(acc3) + summs3;
+    s[4] = hsum_float_8(acc4) + summs4;
+    s[5] = hsum_float_8(acc5) + summs5;
+    s[6] = hsum_float_8(acc6) + summs6;
+    s[7] = hsum_float_8(acc7) + summs7;
+#else
+    for (int k = 0; k < 8; ++k) ggml_vec_dot_q5_K_q8_K(n, &s[k], 0, vx, 0, vy[k], 0, 1);
+#endif
