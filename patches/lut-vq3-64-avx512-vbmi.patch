+        __m512i sumi1_6 = _mm512_setzero_si512(), sumi2_6 = _mm512_setzero_si512();
+        __m512i sumi1_7 = _mm512_setzero_si512(), sumi2_7 = _mm512_setzero_si512();
+        for (int ib = 0; ib < QK_K/32; ib += 2) {
+            const uint64_t packed_idx1 = _pdep_u64(*(const uint32_t *)qs, 0x00ff00ff00ff00ffULL)
