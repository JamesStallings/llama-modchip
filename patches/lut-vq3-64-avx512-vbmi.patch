+struct kv_l3_policy_config {
+    int64_t kv_l3_window;
+    int64_t kv_nta_prefix;
+    int64_t attn_window;
+    int64_t attn_sinks;
+    int64_t swa_stride;
+    const volatile llama_modchip_shm_t * shm_ptr;
+
+    kv_l3_policy_config() : shm_ptr(nullptr) {
+        const char * env_w  = getenv("LLAMA_KV_L3_WINDOW");
+        kv_l3_window        = env_w ? atoll(env_w) : 2048;
+        const char * env_p  = getenv("LLAMA_KV_L3_NTA_PREFIX");
+        kv_nta_prefix       = env_p ? atoll(env_p) : -1;
+        const char * env_aw = getenv("LLAMA_ATTN_WINDOW");
+        attn_window         = env_aw ? atoll(env_aw) : 0;
+        const char * env_as = getenv("LLAMA_ATTN_SINKS");
+        attn_sinks          = env_as ? atoll(env_as) : 16;
+        const char * env_st = getenv("LLAMA_SWA_STRIDE");
+        swa_stride          = env_st ? atoll(env_st) : 0;
+
+        int fd = open("/dev/shm/llama_modchip.bin", O_RDONLY);
+        if (fd >= 0) {
+            void * p = mmap(nullptr, sizeof(llama_modchip_shm_t), PROT_READ, MAP_SHARED, fd, 0);
+            close(fd);
+            if (p != MAP_FAILED) {
+                const llama_modchip_shm_t * s = (const llama_modchip_shm_t *)p;
+                if (s->magic == 0x4D4F4443u) {
+                    shm_ptr = s;
+                }
+            }
+        }
+
+        if (attn_window > 0) {
+            fprintf(stderr, "[GGML-MODCHIP] SWA ACTIVE: Window=%ld, Sinks=%ld, Stride=%ld, L3 Window=%ld\n",
+                    (long)attn_window, (long)attn_sinks, (long)swa_stride, (long)kv_l3_window);
+        } else {
+            fprintf(stderr, "[GGML-MODCHIP] Full 256K Global Attention ACTIVE: Window=FULL, L3 NTA Window=%ld\n",
+                    (long)kv_l3_window);
+        }
+    }
+};
+
+static inline const kv_l3_policy_config & get_kv_l3_policy() {
+    static const kv_l3_policy_config cfg;
+    return cfg;
+}
+
+static inline int parse_tensor_layer_id(const ggml_tensor * t) {
+    if (!t) return -1;
+    const char * s = (t->view_src && t->view_src->name[0]) ? t->view_src->name : t->name;
+    int last_num = -1;
+    while (*s) {
+        if (*s >= '0' && *s <= '9') {
+            int v = 0;
+            while (*s >= '0' && *s <= '9') {
+                v = v * 10 + (*s - '0');
+                s++;
+            }
+            last_num = v;
+        } else {
+            s++;
+        }
+    }
+    return last_num;
+}
