+                sumi1_1 = _mm512_add_epi32(sumi1_1, _mm512_madd_epi16(dot12, scale_512));
+                sumi2_1 = _mm512_add_epi32(sumi2_1, _mm512_madd_epi16(dot34, scale_512));
