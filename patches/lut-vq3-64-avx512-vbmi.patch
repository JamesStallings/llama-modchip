+void quantize_row_q8_K(const float * GGML_RESTRICT x, void * GGML_RESTRICT vy, int64_t k) {
+#if defined(__AVX512F__) && defined(__AVX512BW__) && defined(__AVX512VL__)
+    assert(k % QK_K == 0);
+    const int64_t nb = k / QK_K;
+    block_q8_K * GGML_RESTRICT y = (block_q8_K *)vy;
+    const __m512i v_127 = _mm512_set1_epi32(127);
+
+    for (int64_t i = 0; i < nb; ++i) {
+        __m512 v[16];
+        __m512 vmax_abs = _mm512_setzero_ps();
+        for (int g = 0; g < 16; ++g) {
+            v[g] = _mm512_loadu_ps(x + 16 * g);
+            vmax_abs = _mm512_max_ps(vmax_abs, _mm512_abs_ps(v[g]));
+        }
+        const float amax = _mm512_reduce_max_ps(vmax_abs);
+        if (!amax) {
+            y[i].d = 0.0f;
+            memset(y[i].qs, 0, QK_K);
+            memset(y[i].bsums, 0, sizeof(y[i].bsums));
+            x += QK_K;
+            continue;
+        }
+        const __m512 v_amax = _mm512_set1_ps(amax);
+        float max_val = 0.0f;
+        for (int g = 0; g < 16; ++g) {
+            const __mmask16 m = _mm512_cmpeq_ps_mask(_mm512_abs_ps(v[g]), v_amax);
+            if (m) {
+                max_val = x[16 * g + __builtin_ctz(m)];
+                break;
+            }
+        }
+        const float iscale = -127.0f / max_val;
+        const __m512 v_iscale = _mm512_set1_ps(iscale);
+
+        for (int g = 0; g < 4; ++g) {
+            const __m512i i0 = _mm512_min_epi32(v_127, _mm512_cvtps_epi32(_mm512_mul_ps(v[4*g + 0], v_iscale)));
+            const __m512i i1 = _mm512_min_epi32(v_127, _mm512_cvtps_epi32(_mm512_mul_ps(v[4*g + 1], v_iscale)));
+            const __m512i i2 = _mm512_min_epi32(v_127, _mm512_cvtps_epi32(_mm512_mul_ps(v[4*g + 2], v_iscale)));
+            const __m512i i3 = _mm512_min_epi32(v_127, _mm512_cvtps_epi32(_mm512_mul_ps(v[4*g + 3], v_iscale)));
+
+            _mm_storeu_si128((__m128i *)(y[i].qs + 64*g +  0), _mm512_cvtepi32_epi8(i0));
+            _mm_storeu_si128((__m128i *)(y[i].qs + 64*g + 16), _mm512_cvtepi32_epi8(i1));
+            _mm_storeu_si128((__m128i *)(y[i].qs + 64*g + 32), _mm512_cvtepi32_epi8(i2));
+            _mm_storeu_si128((__m128i *)(y[i].qs + 64*g + 48), _mm512_cvtepi32_epi8(i3));
+
+            const __m256i s0 = _mm256_add_epi32(_mm512_castsi512_si256(i0), _mm512_extracti64x4_epi64(i0, 1));
+            const __m256i s1 = _mm256_add_epi32(_mm512_castsi512_si256(i1), _mm512_extracti64x4_epi64(i1, 1));
+            const __m256i s2 = _mm256_add_epi32(_mm512_castsi512_si256(i2), _mm512_extracti64x4_epi64(i2, 1));
+            const __m256i s3 = _mm256_add_epi32(_mm512_castsi512_si256(i3), _mm512_extracti64x4_epi64(i3, 1));
+            const __m256i h01 = _mm256_hadd_epi32(s0, s1);
+            const __m256i h23 = _mm256_hadd_epi32(s2, s3);
+            const __m256i h0123 = _mm256_hadd_epi32(h01, h23);
+            const __m128i bsum4 = _mm_add_epi32(_mm256_castsi256_si128(h0123), _mm256_extracti128_si256(h0123, 1));
+            _mm_storeu_si64(&y[i].bsums[4*g], _mm_packs_epi32(bsum4, bsum4));
+        }
+        y[i].d = 1.0f / iscale;
+        x += QK_K;
+    }
+#else
+    quantize_row_q8_K_ref(x, vy, k);
+#endif
 }
 
