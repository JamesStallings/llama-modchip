+    s[0] = 0.125f * hsum_float_8(acc0);
+    s[1] = 0.125f * hsum_float_8(acc1);
+#else
+    for (int k = 0; k < 2; ++k) ggml_vec_dot_iq2_xxs_q8_K(n, &s[k], 0, vx, 0, vy[k], 0, 1);
